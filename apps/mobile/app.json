{
  "expo": {
    "name": "simpleTracker",
    "slug": "simpletracker",
    "scheme": "simpletracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.simplesuite.simpletracker"
    },
    "android": {
      "package": "com.simplesuite.simpletracker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": ""
    },
    "plugins": [
      "expo-sharing",
      "expo-web-browser",
      "expo-notifications"
    ]
  }
}
